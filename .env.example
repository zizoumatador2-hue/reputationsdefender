# Copy to .env for local development. Never commit real values.
# Variables prefixed PUBLIC_ are embedded in the browser bundle: do not put secrets in them.

# --- Public (build time) ---
# Google Analytics 4 measurement ID. Analytics loads only when set.
PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (the content value only).
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Cloudflare Turnstile site key (public). Enables the bot check on forms.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (Cloudflare Pages: Settings > Environment variables, mark as secret) ---
# Turnstile secret key. Without it, server-side verification is skipped.
TURNSTILE_SECRET_KEY=
# Lead delivery: a CRM, Zapier/Make, or your own endpoint that accepts JSON POST.
# Without it, scan requests still return the sample report, but contact requests show a "not set up" message.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# --- Stripe (not yet live; see docs/LAUNCH_READINESS.md) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
# Used for Stripe success and cancel redirects. Defaults to https://reputationsdefender.com.
PUBLIC_SITE_URL=
