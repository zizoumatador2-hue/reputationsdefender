---
import { SITE, FOOTER_LINKS } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand">
        <img src="/images/logo.png" alt="" width="32" height="32" />
        <span>{SITE.name}</span>
      </a>
      <p>{SITE.tagline}.</p>
      <p class="muted">Educational content only — not legal advice.</p>
    </div>
    <div>
      <h3>Company</h3>
      <ul>
        {FOOTER_LINKS.company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h3>Topics</h3>
      <ul>
        {FOOTER_LINKS.topics.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h3>Legal</h3>
      <ul>
        {FOOTER_LINKS.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {year} {SITE.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding-block: 3rem 1.5rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 2rem;
  }
  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: 0.6rem;
  }
  .footer-brand p { color: var(--color-text-muted); font-size: 0.92rem; max-width: 32ch; }
  .muted { font-size: 0.85rem !important; }
  h3 { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); margin: 0 0 0.9rem; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  ul a { color: var(--color-text); text-decoration: none; font-size: 0.94rem; }
  ul a:hover { color: var(--color-primary); }
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
