---
// Loads Google Analytics and Search Console verification only when configured.
// Set PUBLIC_GA_MEASUREMENT_ID and PUBLIC_GOOGLE_SITE_VERIFICATION in the build environment.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---
{verification && <meta name="google-site-verification" content={verification} />}
{gaId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', gaId);
    </script>
  </>
)}
