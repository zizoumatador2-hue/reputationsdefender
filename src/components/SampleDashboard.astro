---
// Static preview of the scan dashboard. Values are illustrative sample data.
---
<figure class="sample-dashboard" aria-labelledby="sample-dash-caption">
  <div class="sample-banner" role="note">
    <strong>Sample dashboard.</strong> Illustrative values only. This is not a real report about any person or business.
  </div>
  <div class="report-overview">
    <div class="card score-card tone-attention">
      <div class="ring-wrap">
        <svg viewBox="0 0 120 120" aria-hidden="true" class="score-ring">
          <circle cx="60" cy="60" r="52" class="ring-track"></circle>
          <circle cx="60" cy="60" r="52" class="ring-progress" stroke-dasharray="326.7" stroke-dashoffset="104.5"></circle>
        </svg>
        <p class="ring-score">68</p>
      </div>
      <p class="score-band">Needs Attention</p>
      <p class="score-meaning">Mixed results or gaps in profiles that deserve a plan.</p>
    </div>
    <div class="metric-grid">
      <div class="card metric"><p class="metric-label">Search Visibility</p><p class="metric-value">61/100</p><p class="metric-note">How prominently your name appears in results.</p></div>
      <div class="card metric"><p class="metric-label">Review Presence</p><p class="metric-value">72/100</p><p class="metric-note">How visible reviews and ratings are.</p></div>
    </div>
  </div>
  <figcaption id="sample-dash-caption" class="visually-hidden">Sample reputation dashboard with a score of 68 out of 100.</figcaption>
</figure>
