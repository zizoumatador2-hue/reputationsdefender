---
import { SITE, NAV } from '../lib/site';
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <img src="/images/logo.png" alt="" width="36" height="36" />
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul id="primary-nav" class="nav-list">
        {NAV.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="btn btn-primary btn-sm header-cta" href="/free-reputation-scan/" data-track="header_free_scan">Get Free Scan</a>
      <button id="nav-toggle" class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
        <span class="visually-hidden">Menu</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>
<a class="mobile-cta btn btn-primary" href="/free-reputation-scan/" data-track="mobile_bar_free_scan">Get Your Free Reputation Scan</a>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.8rem;
    gap: 1.25rem;
    position: relative;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .header-actions { display: flex; align-items: center; gap: 0.6rem; }
  .btn-sm { min-height: 44px; padding: 0.5em 1em; font-size: 0.95rem; white-space: nowrap; }
  .mobile-cta { display: none; }
  .nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    cursor: pointer;
  }
  .nav-list {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
  }
  .nav-list a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.93rem;
    white-space: nowrap;
  }
  .nav-list a:hover { color: var(--color-primary); }
  .nav-list a[aria-current='page'] { color: var(--color-primary); text-decoration: underline; }

  @media (max-width: 640px) {
    .header-cta { display: none; }
    .brand { font-size: 1.05rem; }
    .mobile-cta {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 60;
      border-radius: 0;
      min-height: 56px;
      box-shadow: 0 -4px 14px rgba(16, 24, 40, 0.12);
    }
    :global(body) { padding-bottom: 56px; }
  }

  @media (max-width: 1080px) {
    .nav-toggle { display: inline-flex; }
    .nav-list {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      flex-direction: column;
      padding: 1rem 1.25rem;
      gap: 0.9rem;
    }
    .nav-list.open { display: flex; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const list = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const open = list?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
</script>
