---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  modDate: Date;
  author: string;
  slug: string;
  categoryLabel: string;
  categoryHref: string;
}

const { title, description, pubDate, modDate, author, slug, categoryLabel, categoryHref } = Astro.props;

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout {title} {description} ogType="article" publishedTime={pubDate.toISOString()} modifiedTime={modDate.toISOString()}>
  <SchemaOrg type="Article" article={{ title, description, pubDate, modDate, author, slug }} />
  <article class="container article">
    <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: categoryLabel, url: categoryHref }, { name: title, url: slug }]} />

    <header class="article-header">
      <h1>{title}</h1>
      <p class="article-meta">
        By <span class="author">{author}</span> ·
        Published <time datetime={pubDate.toISOString()}>{dateFmt(pubDate)}</time>
        {modDate.getTime() !== pubDate.getTime() && (
          <> · Updated <time datetime={modDate.toISOString()}>{dateFmt(modDate)}</time></>
        )}
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>

    <aside class="disclaimer" aria-label="Editorial disclaimer">
      <p><strong>Editorial note:</strong> This article is for general informational purposes and does not constitute legal advice. {SITE.name} does not guarantee specific Google ranking or content-removal outcomes. See our <a href="/editorial-policy/">editorial policy</a>.</p>
    </aside>
  </article>
</BaseLayout>

<style>
  .article { max-width: 880px; padding-block: 2rem 4rem; }
  .article-header { margin-bottom: 2rem; }
  .article-meta { color: var(--color-text-muted); font-size: 0.92rem; }
  .author { font-weight: 600; color: var(--color-text); }
  .disclaimer {
    margin-top: 3rem;
    padding: 1.1rem 1.3rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
